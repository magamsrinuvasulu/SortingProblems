class Solution {
    public int dominantIndex(int[] nums) {
        int max=0,second=0,index=0;
        for(int i=0;i<nums.length;i++){
            if(nums[i]>max){
                second=max;
                max=nums[i];
                index=i;
            }else if(nums[i]>second){
                second=nums[i];
            }
        }
        return max>=2*second?index:-1;
    }
}
